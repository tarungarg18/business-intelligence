# ============================================================================
#  TEMPLATE ONLY — THIS FILE IS COMMITTED TO GIT.
#  NEVER PUT A REAL KEY HERE. Copy this file to `.env` and fill that in;
#  `.env` is gitignored, this file is not. A test enforces this.
# ============================================================================
#
# Every key is optional. With none set, Verity falls back to offline LSA
# embeddings and a template generator, and the full pipeline still runs.

# --- Primary: Google Gemini (embeddings + generation) ---
GEMINI_API_KEY=
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GEMINI_CHAT_MODEL=gemini-2.5-flash

# --- Fallback: OpenRouter, or any OpenAI-compatible endpoint ---
# Setting OPENROUTER_API_KEY alone is enough; the base URL is inferred.
#
# NOTE: OpenRouter serves chat completions only — it has no embeddings
# endpoint, so it is wired as a generation fallback and skipped for
# embeddings. Free models there are rate-limited upstream from time to time.
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_CHAT_MODEL=google/gemma-4-31b-it:free

# --- Third fallback: Hugging Face Inference Providers (generation only) ---
# The OpenAI-compatible HF router is chat-completions only, so it is wired
# after OpenRouter/OpenAI-compatible generation and before the offline floor.
HF_TOKEN=
# HF_CHAT_MODEL=meta-llama/Llama-3.1-8B-Instruct:fastest

# --- Or any other OpenAI-compatible endpoint (OpenCode, Together, Ollama) ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENCODE_CHAT_MODEL=gpt-4o-mini
# OPENCODE_EMBED_MODEL=text-embedding-3-small
